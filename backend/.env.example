# Local backend settings. Never put production secrets in this file.
APP_HOST=127.0.0.1
APP_PORT=8080
DATABASE_URL=postgresql://YOUR_SUPABASE_USER:YOUR_SUPABASE_PASSWORD@YOUR_SUPABASE_POOLER_HOST:5432/postgres?sslmode=require
SESSION_COOKIE_NAME=worldz_session
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false
AUTH_RECIPIENT=localhost:3000
# Merchant identity network; payment checkout may support additional networks.
AUTH_NETWORK_ID=testnet
AUTH_CHALLENGE_TTL_SECONDS=300

# Comma-separated list of allowed CORS origins (no trailing slash).
# In production: CORS_ORIGINS=https://app.example.com,https://merchant.example.com
# For local dev: CORS_ORIGINS=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# NEAR JSON-RPC endpoints; signing uses a backend-only Ed25519 seed, not a wallet key.
NEAR_TESTNET_RPC_URL=https://archival-rpc.testnet.fastnear.com
NEAR_TESTNET_RPC_FALLBACK_URLS=https://near-testnet.drpc.org,https://testnet-rpc.intea.rs,https://test.rpc.fastnear.com,https://rpc.testnet.near.org
NEAR_MAINNET_RPC_URL=https://rpc.mainnet.near.org
NEAR_TESTNET_ROUTER_ID=
NEAR_MAINNET_ROUTER_ID=
NEAR_TESTNET_FEE_RECIPIENT=
NEAR_MAINNET_FEE_RECIPIENT=
NEAR_TESTNET_SIGNER_KEY_ID=worldz-testnet-1
NEAR_TESTNET_SIGNER_SEED_BASE64=
NEAR_MAINNET_SIGNER_KEY_ID=worldz-mainnet-1
NEAR_MAINNET_SIGNER_SEED_BASE64=
NEAR_TESTNET_FT_ALLOWLIST=usdc.fakes.testnet,usdt.fakes.testnet,dai.fakes.testnet
NEAR_MAINNET_FT_ALLOWLIST=
NEAR_TESTNET_INDEXER_START_HEIGHT=0
NEAR_MAINNET_INDEXER_START_HEIGHT=0

# Outbound merchant webhook delivery and retry workers.
WEBHOOK_SIGNING_SECRET=

# Shopify app connection. Generate a random 32-byte key and base64 encode it.
# Example: openssl rand -base64 32
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SHOPIFY_CHECKOUT_URL=
SHOPIFY_TOKEN_ENCRYPTION_KEY_BASE64=
