# Public NEAR network configuration. Use testnet during hackathon development.
NEXT_PUBLIC_NEAR_NETWORK_ID=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_NEAR_EXPLORER_URL=https://testnet.nearblocks.io
NEXT_PUBLIC_NEAR_CONTRACT_ID=your-router.testnet
# Optional comma-separated NEP-141 contracts shown in the wallet balance card.
NEXT_PUBLIC_NEAR_FT_CONTRACTS=

# Public Rust backend URL. Browser calls go through /api/v1 to keep cookies same-origin.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
# Optional server-side-only override for the frontend API proxy.
NEAR_BACKEND_URL=http://localhost:8080
